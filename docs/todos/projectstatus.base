formulas:
  Untitled: ""
properties:
  status:
    displayName: Status
views:
  - type: table
    name: todos
    filters:
      and:
        - file.inFolder("todos")
        - status == false
        - or:
            - |-
              ! file.properties["depending-on"].map(
              file(value).properties["status"]).contains(false)
            - note["depending-on"].isEmpty()
    order:
      - file.name
      - formula.Untitled
    sort:
      - property: formula.filter dependencies
        direction: DESC
